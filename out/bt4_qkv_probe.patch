+def fuse_qkv(nodes, weights, quantized, constants):
+    groups = {}
+    for node in nodes:
+        op, names, outputs, _ = node
+        if op == 'MatMul' and any(part in names[1] for part in ('/mha/Q/', '/mha/K/', '/mha/V/')):
+            if names[1] in weights or names[1] in quantized:
+                groups.setdefault(names[0], []).append(node)
+    replacements, removed = {}, set()
+    for source, projections in groups.items():
+        if len(projections) != 3:
+            continue
+        names = [node[1][1] for node in projections]
+        configurations = [quantized.get(name) for name in names]
+        configurations = [tuple(c[:2]) + (c[2] if len(c) > 2 else True,) if c else None for c in configurations]
+        if len(set(configurations)) != 1:
+            continue
+        fused = names[0] + '.qkv'
+        if configurations[0]:
+            group, bits, transpose = configurations[0]
+            axis = 0 if transpose else 1
+            widths = [weights[name + '.packed'].shape[0] if transpose else weights[name + '.scales'].shape[1] * group for name in names]
+            for suffix in ('.packed', '.scales', '.biases'):
+                weights[fused + suffix] = mx.concatenate([weights[name + suffix] for name in names], axis=axis)
+            quantized[fused] = list(configurations[0])
+        else:
+            widths = [weights[name].shape[1] for name in names]
+            weights[fused] = mx.concatenate([weights[name] for name in names], axis=1)
+        split = fused + '.split'
+        constants[split] = np.array(widths, dtype=np.int32)
+        outputs = [node[2][0] for node in projections]
+        replacements[outputs[0]] = [['MatMul', [source, fused], [fused + '.out'], {}],
+                                    ['Split', [fused + '.out', split], outputs, {'axis': -1}]]
+        removed.update(outputs)
+    result = []
+    for node in nodes:
+        if node[2][0] in replacements:
+            result.extend(replacements[node[2][0]])
+        elif node[2][0] not in removed:
+            result.append(node)
+    referenced = {name for node in result for name in node[1]}
+    for name in [node[1][1] for group in groups.values() for node in group]:
+        if name not in referenced:
+            for key in (name, name + '.packed', name + '.scales', name + '.biases'):
+                weights.pop(key, None)
+            quantized.pop(name, None)
+    return result
+
